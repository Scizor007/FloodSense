# ==============================================================================
# FRONTEND CONFIGURATION (Vercel Environment Variables)
# ==============================================================================
# Set this in Vercel Project Settings -> Environment Variables
# Points to your deployed FastAPI backend on Render
NEXT_PUBLIC_API_URL=https://floodsense-backend.onrender.com
# Alternatively, VITE_API_URL is also supported:
# VITE_API_URL=https://floodsense-backend.onrender.com

# ==============================================================================
# BACKEND CONFIGURATION (Render Environment Variables)
# ==============================================================================

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=floodsense

# CORS: Set FRONTEND_URL to your Vercel deployment URL so the browser can make API requests
FRONTEND_URL=https://your-floodsense-frontend.vercel.app
CORS_ORIGINS=https://your-floodsense-frontend.vercel.app,http://localhost:3000

# Google Gemini Multimodal Vision API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# OpenRouteService API (for dynamic avoidance routing)
ORS_API_KEY=your_openrouteservice_api_key

# Twilio SMS & WhatsApp Alerts (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SMTP Email Dispatch (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=prajwalupadhyay23@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_RECIPIENTS=prajwal.ff1234@gmail.com,kjaathvika@gmail.com
